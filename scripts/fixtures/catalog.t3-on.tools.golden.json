 {
  "name": "progress",
  "description": "Append progress. Set blocker:true or start note with BLOCKED: or QUESTION: to forward a question to the owner thread. A note over 4096 bytes is cut.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "request_id": {
     "type": "string"
    },
    "claim_id": {
     "type": "string"
    },
    "note": {
     "type": "string",
     "maxLength": 262144
    },
    "blocker": {
     "type": "boolean"
    }
   },
   "required": [
    "request_id",
    "claim_id",
    "note"
   ],
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": false
  }
 },
 {
  "name": "finish",
  "description": "Store a terminal worker report; completion is not owner acceptance. summary is optional: when absent it is the first line of result, and one over 4096 bytes is cut.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "request_id": {
     "type": "string"
    },
    "claim_id": {
     "type": "string"
    },
    "outcome": {
     "type": "string",
     "enum": [
      "completed",
      "blocked",
      "failed"
     ]
    },
    "summary": {
     "type": "string",
     "maxLength": 262144
    },
    "result": {
     "type": "string",
     "maxLength": 262144
    },
    "artifact_ids": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "maxItems": 8
    }
   },
   "required": [
    "request_id",
    "claim_id",
    "outcome",
    "result"
   ],
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  }
 },
 {
  "name": "list_files",
  "description": "List files in this assignment's checked-out repository workspace. Read-only; scoped to the assignment. When truncated is true, pass next_cursor as cursor to get the next page.",
