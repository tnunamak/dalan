 {
  "name": "claim",
  "description": "Claim one immutable assignment and see available_checks before choosing run_check.check_id. lease_ms sets this grant’s duration, up to the owner-configured maximum. An exact live retry retains the grant and its stored duration.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "request_id": {
     "type": "string"
    },
    "claimant": {
     "type": "string"
    },
    "acquisition_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 128,
     "pattern": "^[A-Za-z0-9_-]+$"
    },
    "lease_ms": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3600000
    }
   },
   "required": [
    "request_id",
    "claimant"
   ],
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  }
 },
 {
  "name": "get",
