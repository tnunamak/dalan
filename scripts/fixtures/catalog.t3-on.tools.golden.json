 {
  "name": "artifact_chunk",
  "description": "Upload a sealed artifact for any claimed assignment, including read-only assignments.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "request_id": {
     "type": "string"
    },
    "claim_id": {
     "type": "string"
    },
    "artifact_id": {
     "type": "string"
    },
    "offset": {
     "type": "integer",
     "minimum": 0
    },
    "data_base64": {
     "type": "string"
    },
    "final": {
     "type": "boolean"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-fA-F0-9]{64}$"
    }
   },
   "required": [
    "request_id",
    "claim_id",
    "artifact_id",
    "offset",
    "data_base64"
   ],
   "additionalProperties": false
