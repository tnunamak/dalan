     "type": "string",
     "maxLength": 1024
    }
   },
   "required": [
    "request_id",
    "claim_id"
   ],
   "additionalProperties": false
  },
  "annotations": {
   "readOnlyHint": true,
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false
  }
 },
