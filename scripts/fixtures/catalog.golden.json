 "tools": {
  "resultType": "complete",
  "ttlMs": 0,
  "cacheScope": "private",
  "tools": [
   {
    "name": "list_pending",
    "description": "List up to 50 queued assignment IDs and titles.",
    "inputSchema": {
     "type": "object",
     "properties": {},
     "required": [],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "claim",
    "description": "Claim one immutable assignment and see available_checks before choosing run_check.check_id. lease_ms sets this grant’s duration, up to the owner-configured maximum. An exact live retry retains the grant and its stored duration.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claimant": {
       "type": "string"
      },
      "acquisition_id": {
       "type": "string",
       "minLength": 1,
       "maxLength": 128,
       "pattern": "^[A-Za-z0-9_-]+$"
      },
      "lease_ms": {
       "type": "integer",
       "minimum": 1,
       "maximum": 3600000
      }
     },
     "required": [
      "request_id",
      "claimant"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "get",
    "description": "Read assignment, available_checks, cancellation, progress, report and delivery facts.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      }
     },
     "required": [
      "request_id"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "ack_message",
    "description": "Acknowledge a lightweight message after reading it; no claim or finish is needed.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "message_id": {
       "type": "string"
      }
     },
     "required": [
      "message_id"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "progress",
    "description": "Append progress. Set blocker:true or start note with BLOCKED: or QUESTION: to forward a question to the owner thread. A note over 4096 bytes is cut.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claim_id": {
       "type": "string"
      },
      "note": {
       "type": "string",
       "maxLength": 262144
      },
      "blocker": {
       "type": "boolean"
      }
     },
     "required": [
      "request_id",
      "claim_id",
      "note"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": false,
     "openWorldHint": false
    }
   },
   {
    "name": "finish",
    "description": "Store a terminal worker report; completion is not owner acceptance. summary is optional: when absent it is the first line of result, and one over 4096 bytes is cut.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claim_id": {
       "type": "string"
      },
      "outcome": {
       "type": "string",
       "enum": [
        "completed",
        "blocked",
        "failed"
       ]
      },
      "summary": {
       "type": "string",
       "maxLength": 262144
      },
      "result": {
       "type": "string",
       "maxLength": 262144
      },
      "artifact_ids": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "maxItems": 8
      }
     },
     "required": [
      "request_id",
      "claim_id",
      "outcome",
      "result"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "list_files",
    "description": "List files in this assignment's checked-out repository workspace. Read-only; scoped to the assignment. When truncated is true, pass next_cursor as cursor to get the next page.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claim_id": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 200
      },
      "cursor": {
       "type": "string",
       "maxLength": 1024
      }
     },
     "required": [
      "request_id",
      "claim_id"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "read_file",
    "description": "Read a file from this assignment's checked-out repository workspace. Read-only; scoped to the assignment. The result has end_line (the last line included) and truncated (true when the 32 KiB cap cut the requested window).",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claim_id": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "start_line": {
       "type": "integer",
       "minimum": 1
      },
      "max_lines": {
       "type": "integer",
       "minimum": 1,
       "maximum": 200
      }
     },
     "required": [
      "request_id",
      "claim_id",
      "path"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "apply_patch",
    "description": "Apply a unified diff to this assignment's private workspace copy. Changes stay local until the owner reviews them; nothing is pushed.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claim_id": {
       "type": "string"
      },
      "patch": {
       "type": "string",
       "maxLength": 262144
      }
     },
     "required": [
      "request_id",
      "claim_id",
      "patch"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": false,
     "openWorldHint": false
    }
   },
   {
    "name": "run_check",
    "description": "Start a listed repository check. Returns immediately for long checks; poll workspace_result for status and result. Fast checks may return a completed receipt. Unknown check_id returns available IDs.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claim_id": {
       "type": "string"
      },
      "check_id": {
       "type": "string"
      }
     },
     "required": [
      "request_id",
      "claim_id",
      "check_id"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": false,
     "openWorldHint": false
    }
   },
   {
    "name": "workspace_result",
    "description": "Read the current diff, available_checks, check receipts, and artifact references.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claim_id": {
       "type": "string"
      }
     },
     "required": [
      "request_id",
      "claim_id"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": true,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "artifact_chunk",
    "description": "Upload a sealed artifact for any claimed assignment, including read-only assignments.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "claim_id": {
       "type": "string"
      },
      "artifact_id": {
       "type": "string"
      },
      "offset": {
       "type": "integer",
       "minimum": 0
      },
      "data_base64": {
       "type": "string"
      },
      "final": {
       "type": "boolean"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[a-fA-F0-9]{64}$"
      }
     },
     "required": [
      "request_id",
      "claim_id",
      "artifact_id",
      "offset",
      "data_base64"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": false
    }
   },
   {
    "name": "notify_owner",
    "description": "Send a short notification to the owner through the configured ntfy alert path.",
    "inputSchema": {
     "type": "object",
     "properties": {
      "text": {
       "type": "string",
       "maxLength": 1000
      }
     },
     "required": [
      "text"
     ],
     "additionalProperties": false
    },
    "annotations": {
     "readOnlyHint": false,
     "destructiveHint": false,
     "idempotentHint": false,
     "openWorldHint": true
    }
   },
   {
    "name": "list_tools",
    "description": "Call this first to learn which tools you can use. Returns registry_version and each available tool with its description, input schema, class (read or write) and schema_hash.",
