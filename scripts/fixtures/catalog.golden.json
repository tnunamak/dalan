   {
    "name": "call_tool_write",
    "description": "Run an available tool that changes state or sends something, by name, as listed by list_tools. Requires its schema_hash from list_tools and an idempotency_key that is new for each distinct request.",
    "inputSchema": {
     "type": "object",
     "properties": {
