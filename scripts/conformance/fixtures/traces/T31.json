    "command": {
     "v": 0,
     "op": "submit",
     "job": "J",
     "key": "k1",
     "body": {
      "source": "git:BASE",
      "scope": "read:fixture",
      "policy": "P0",
      "destination": "owner-inbox",
      "retainUntil": 1000
     }
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "revision": 1
     }
    },
    "events": [
