     }
    ]
   }
  },
  {
   "input": {
    "principal": "W1",
    "command": {
     "v": 0,
     "op": "finish",
     "job": "J",
     "key": "k4",
     "body": {
      "outcome": "completed",
      "summary": "done",
      "artifacts": [],
      "source": "git:BASE",
      "policy": "P0"
