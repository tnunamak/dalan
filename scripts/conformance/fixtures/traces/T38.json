{
 "id": "T38",
 "name": "Retention tombstone never resurrects",
 "invariant": "R2 R10",
 "steps": [
  {
   "input": {
    "principal": "owner",
    "command": {
     "v": 0,
     "op": "submit",
     "job": "J",
     "key": "k1",
     "body": {
      "source": "git:BASE",
      "scope": "read:fixture",
      "policy": "P0",
      "destination": "owner-inbox",
      "retainUntil": 1000
     }
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "revision": 1
     }
    },
    "events": [
     {
      "v": 0,
      "source": "urn:fixture:job-store",
      "id": "J:1",
      "job": "J",
      "seq": 1,
      "revision": 1,
      "epoch": 0,
      "type": "submitted",
      "state": "queued"
     }
    ]
   }
  },
  {
   "input": {
    "principal": "W1",
    "command": {
     "v": 0,
     "op": "claim",
     "job": "J",
     "key": "k2",
     "body": {
      "leaseMs": 100
     },
     "revision": 1
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "revision": 2,
      "epoch": 1,
      "claim": "C1",
      "leaseUntil": 100
     }
    },
    "events": [
     {
      "v": 0,
      "source": "urn:fixture:job-store",
      "id": "J:2",
      "job": "J",
      "seq": 2,
      "revision": 2,
      "epoch": 1,
      "type": "claimed",
      "state": "leased"
     }
    ]
   }
  },
  {
   "control": {
    "op": "advance",
    "to": 1000
   },
   "expect": {
    "now": 1000
   }
  },
  {
   "input": {
    "principal": "owner",
    "command": {
     "v": 0,
     "op": "get",
     "job": "J",
     "key": "k3",
     "body": {}
    }
   },
   "expect": {
    "reply": {
     "ok": false,
     "code": "TOMBSTONE"
    },
    "events": []
   }
  },
  {
   "input": {
    "principal": "owner",
    "command": {
     "v": 0,
     "op": "submit",
     "job": "J",
     "key": "k4",
     "body": {
      "source": "git:BASE",
      "scope": "read:fixture",
      "policy": "P0",
      "destination": "owner-inbox",
      "retainUntil": 2000
     }
    }
   },
   "expect": {
    "reply": {
     "ok": false,
     "code": "TOMBSTONE"
    },
    "events": []
   }
  }
 ]
}
