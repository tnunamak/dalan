{
 "id": "T32",
 "name": "Separate input and terminal waiters",
 "invariant": "R8",
 "steps": [
  {
   "input": {
    "principal": "owner",
    "command": {
     "v": 0,
     "op": "submit",
     "job": "J",
     "key": "k1",
     "body": {
      "source": "git:BASE",
      "scope": "read:fixture",
      "policy": "P0",
      "destination": "owner-inbox",
      "retainUntil": 1000
     }
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "revision": 1
     }
    },
    "events": [
     {
      "v": 0,
      "source": "urn:fixture:job-store",
      "id": "J:1",
      "job": "J",
      "seq": 1,
      "revision": 1,
      "epoch": 0,
      "type": "submitted",
      "state": "queued"
     }
    ]
   }
  },
  {
   "input": {
    "principal": "W1",
    "command": {
     "v": 0,
     "op": "claim",
     "job": "J",
     "key": "k2",
     "body": {
      "leaseMs": 100
     },
     "revision": 1
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "revision": 2,
      "epoch": 1,
      "claim": "C1",
      "leaseUntil": 100
     }
    },
    "events": [
     {
      "v": 0,
      "source": "urn:fixture:job-store",
      "id": "J:2",
      "job": "J",
      "seq": 2,
      "revision": 2,
      "epoch": 1,
      "type": "claimed",
      "state": "leased"
     }
    ]
   }
  },
  {
   "input": {
    "principal": "owner",
    "command": {
     "v": 0,
     "op": "wait",
     "job": "J",
     "key": "k3",
     "body": {
      "waiter": "I",
      "predicate": "input",
      "afterSeq": 0,
      "expiresAt": 900
     },
     "revision": 2
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "revision": 3,
      "waiter": "I",
      "delivery": null
     }
    },
    "events": [
     {
      "v": 0,
      "source": "urn:fixture:job-store",
      "id": "J:3",
      "job": "J",
      "seq": 3,
      "revision": 3,
      "epoch": 1,
      "type": "waiter_registered",
      "state": "leased"
     }
    ]
   }
  },
  {
   "input": {
    "principal": "owner",
    "command": {
     "v": 0,
     "op": "wait",
     "job": "J",
     "key": "k4",
     "body": {
      "waiter": "T",
      "predicate": "terminal",
      "afterSeq": 0,
      "expiresAt": 900
     },
     "revision": 3
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "revision": 4,
      "waiter": "T",
      "delivery": null
     }
    },
    "events": [
     {
      "v": 0,
      "source": "urn:fixture:job-store",
      "id": "J:4",
      "job": "J",
      "seq": 4,
      "revision": 4,
      "epoch": 1,
      "type": "waiter_registered",
      "state": "leased"
     }
    ]
   }
  },
  {
   "input": {
    "principal": "W1",
    "command": {
     "v": 0,
     "op": "ask",
     "job": "J",
     "key": "k5",
     "body": {
      "question": "Q",
      "text": "which?"
     },
     "revision": 4,
     "epoch": 1,
     "claim": "C1"
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "revision": 5
     }
    },
    "events": [
     {
      "v": 0,
      "source": "urn:fixture:job-store",
      "id": "J:5",
      "job": "J",
      "seq": 5,
      "revision": 5,
      "epoch": 1,
      "type": "questioned",
      "state": "awaiting_input"
     }
    ]
   }
  },
  {
   "input": {
    "principal": "owner",
    "command": {
     "v": 0,
     "op": "inbox",
     "job": "J",
     "key": "k6",
     "body": {
      "waiter": "I"
     }
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "deliveries": [
       {
        "delivery": "D:I",
        "waiter": "I",
        "job": "J",
        "event": "J:5",
        "state": "pending",
        "receipt": null
       }
      ]
     }
    },
    "events": []
   }
  },
  {
   "input": {
    "principal": "owner",
    "command": {
     "v": 0,
     "op": "inbox",
     "job": "J",
     "key": "k7",
     "body": {
      "waiter": "T"
     }
    }
   },
   "expect": {
    "reply": {
     "ok": true,
     "value": {
      "deliveries": []
     }
    },
    "events": []
   }
  }
 ]
}
